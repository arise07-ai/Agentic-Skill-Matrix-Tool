# Paste into the BACKEND service: Variables -> Raw Editor. Fill in the values marked <...>. Never commit real values.
PORT=8000
OPENAI_API_KEY=<your OpenAI key>
AUTH_SECRET=<long random text, see the guide>
ADMIN_USERNAME=<first admin username>
ADMIN_PASSWORD=<at least 10 characters, remove after the first start>
AUTH_COOKIE_SECURE=true
# The public address of the FRONTEND service (the browser only ever talks to it). Name the frontend service "frontend".
CORS_ORIGINS=https://${{frontend.RAILWAY_PUBLIC_DOMAIN}}
# Leave these empty: the vector index and the cache run inside this service.
# CHROMA_HOST=
# REDIS_URL=
# Optional extras you already use:
# TYPESAFE_API_KEY=
# YOUTUBE_API_KEY=
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=
