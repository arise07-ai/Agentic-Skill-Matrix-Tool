PORT=8000
DATA_DIR=/app/data
HF_HOME=/app/data/hf_cache
OPENAI_API_KEY=<paste your OpenAI key>
LLM_MODEL=gpt-4.1-mini
EMBEDDING_MODEL=text-embedding-3-small
TYPESAFE_API_KEY=<paste your TypeSafe key>
STANDARDIZE_MATCHER=jev
ADMIN_USERNAME=admin
ADMIN_PASSWORD=<new password, at least 10 characters; delete this variable after the first login>
AUTH_SECRET=<new random text: python -c "import secrets;print(secrets.token_urlsafe(48))">
AUTH_COOKIE_SECURE=true
SESSION_HOURS=12
TAVILY_API_KEY=<paste your Tavily key>
AGENT_MAX_STEPS=14
AGENT_MAX_RUNS_PER_HOUR=30
AGENT_ASK_TIMEOUT_SECONDS=600
CACHE_TTL_SECONDS=86400
GPTCACHE_ENABLED=true
GPTCACHE_SIMILARITY=0.95
GPTCACHE_NAMESPACES=requirements
ORCHESTRATION=langgraph
GUARDRAILS_PROVIDER=both
GUARDRAILS_PROVIDER_FAIL=closed
GUARDRAILS_TOXICITY=both
GUARDRAILS_MODERATION_FAIL=open
MODERATION_MODEL=omni-moderation-latest
TRACING_PROVIDER=auto
LANGSMITH_API_KEY=<paste your LangSmith key>
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=skill-matrix
PROMPT_STYLE_STANDARDIZE=few
PROMPT_STYLE_REQUIREMENTS=few
PROMPT_STYLE_GAP_RISK=few
COURSE_SOURCES=catalog,mslearn,youtube
COURSE_CACHE_HOURS=24
MSLEARN_LOCALE=en-us
YOUTUBE_API_KEY=<paste your YouTube key>
YOUTUBE_MAX_SEARCHES_PER_DAY=90
YOUTUBE_CACHE_DAYS=7
UDEMY_MODE=mock
CORS_ORIGINS=https://${{frontend.RAILWAY_PUBLIC_DOMAIN}}
MAX_UPLOAD_MB=10
EVAL_LOG_ENABLED=false
STANDARDIZE_SEMANTIC_THRESHOLD=0.9
STAFFING_WEIGHT_SKILL=0.5
STAFFING_WEIGHT_SEMANTIC=0.3
STAFFING_WEIGHT_ROLE=0.2
