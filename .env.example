# Copy to `.env` (git-ignored) or set these in your platform's secret store.
# NEVER commit real keys. The app reads every secret from the environment only.

# ---------- LLM + embeddings (OpenAI-compatible) ----------
OPENAI_API_KEY=
# OPENAI_BASE_URL=            # Azure / gateway / self-hosted fine-tuned model endpoint
LLM_MODEL=gpt-4.1-mini        # any GPT-4.x / mini class model
EMBEDDING_MODEL=text-embedding-3-small

# ---------- Jev (TypeSafe AI), For Decision Model ----------
TYPESAFE_API_KEY=            # key from the environment / secret store only
STANDARDIZE_MATCHER=jev      # llm (default) or jev: who picks among the candidate skills when matching spellings

# ---------- Login and roles (REQUIRED to log in) ----------
# The first administrator is created from these two values when the backend starts and there are no users yet.
# The admin then adds Project Managers, Team Leaders and HR Managers on the "Users & audit log" page.
# Without them nobody can log in. After the first start you may remove ADMIN_PASSWORD from the environment.
ADMIN_USERNAME=
ADMIN_PASSWORD=  # at least 10 characters
AUTH_SECRET=   # e.g. python -c "import secrets;print(secrets.token_urlsafe(48))"
# AUTH_COOKIE_SECURE=true     # set when the app is served over HTTPS
SESSION_HOURS=12

# ---------- Agents ----------
# Agents need OPENAI_API_KEY (above). Without it they stay off and the UI says so.
TAVILY_API_KEY=                # optional: lets the standardization agent look up unfamiliar skill names on the web
AGENT_MAX_STEPS=14          # model/tool round trips per run
AGENT_MAX_RUNS_PER_HOUR=30  # per user
AGENT_ASK_TIMEOUT_SECONDS=600

# ---------- Vector DB (Chroma) ----------
# docker-compose sets CHROMA_HOST=chroma automatically. Leave unset for local persistent storage.
# CHROMA_HOST=localhost
# CHROMA_PORT=8000
CHROMA_PATH=./data/chroma

# ---------- Cache ----------
# docker-compose sets REDIS_URL automatically.
#REDIS_URL=redis://localhost:6379/0
CACHE_TTL_SECONDS=86400
# Semantic cache (GPTCache) is independent of Redis and can run with the in-memory exact-match fallback.
# Uses a local FAISS vector index and ONNX embeddings; Redis is not required:
# similar-but-different prompts can hit ("Python level 2" vs "level 4"), so keep the list short and the threshold high.
GPTCACHE_ENABLED=true
GPTCACHE_SIMILARITY=0.95
GPTCACHE_NAMESPACES=requirements

# ---------- Orchestration / guardrails / tracing ----------
ORCHESTRATION=langgraph      # sequential | langgraph
GUARDRAILS_PROVIDER=both      # none | builtin | guardrails_ai | nemo | both
GUARDRAILS_PROVIDER_FAIL=closed  # open | closed; reject/withhold if a selected external provider is unavailable
# NEMO_GUARDRAILS_CONFIG=  # default: bundled backend/app/guardrails configuration
GUARDRAILS_TOXICITY=both     # off | wordlist | moderation | both  (cursing / toxic language: input rejected, output masked)
GUARDRAILS_MODERATION_FAIL=open   # open = allow if the moderation service is unreachable | closed = block
MODERATION_MODEL=omni-moderation-latest
TRACING_PROVIDER=auto         # auto | none | langfuse | langsmith
LANGSMITH_API_KEY=
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=skill-matrix

# ---------- Prompt style (one setting per prompt) ----------
# few = worked examples are added to the prompt (default) | zero = instructions only. All other prompts (PDF extraction, learning plan, agents) are always zero-shot.
PROMPT_STYLE_STANDARDIZE=few      # skill standardization
PROMPT_STYLE_REQUIREMENTS=few     # project requirements extraction
PROMPT_STYLE_GAP_RISK=few         # gap risk judgement

# ---------- Learning content (study plans) ----------
COURSE_SOURCES=catalog,mslearn,youtube   # priority order; add "udemy" to also use the Udemy adapter below
# COURSE_CATALOG_PATH=                   # default: backend/app/data/course_catalog.csv (your own curated list)
COURSE_CACHE_HOURS=24                  # how long the Microsoft Learn catalog is kept on disk
MSLEARN_LOCALE=en-us
YOUTUBE_API_KEY=                       # secret: Google Cloud > YouTube Data API v3 > API key. Leave empty to skip videos
YOUTUBE_MAX_SEARCHES_PER_DAY=90        # YouTube's default allowance is about 100 searches a day
YOUTUBE_CACHE_DAYS=7

# ---------- Udemy (optional extra source) ----------
UDEMY_MODE=mock               # mock | affiliate
# UDEMY_CLIENT_ID=
# UDEMY_CLIENT_SECRET=

# ---------- App ----------
CORS_ORIGINS=http://localhost:3000
MAX_UPLOAD_MB=10
EVAL_RAGAS_API=auto     # legacy (default) | collections (ragas 0.4+: ragas.metrics.collections, scored row by row) | auto (collections, else legacy)
EVAL_LOG_ENABLED=true     # log staffing / learning-path answers to data/eval/interactions.jsonl for RAGAS
STANDARDIZE_SEMANTIC_THRESHOLD=0.9
STAFFING_WEIGHT_SKILL=0.5
STAFFING_WEIGHT_SEMANTIC=0.3
STAFFING_WEIGHT_ROLE=0.2
